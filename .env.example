# Host port that maps to nginx:80 in the container.
HOST_PORT=8080

# Upstream repository to mirror. Override if you maintain a fork.
REPO_URL=https://github.com/kemalsanli/umtx2.git
REPO_REF=main

# Container timezone — affects cron-trigger times shown in logs.
# (Cron schedule itself is interpreted in the container's local time,
# so set this to your timezone if you want the 06:00/18:00 pulls to run
# at your local 06:00/18:00 instead of UTC.)
TZ=UTC
